# .secrets.example - Template for environment secrets and API credentials
#
# USAGE IN GITHUB CODESPACES:
#   Set these secrets in GitHub under:
#   GitHub Settings -> Codespaces -> "Codespaces secrets"
#   URL: https://github.com/settings/codespaces
#   Codespaces will automatically populate them as environment variables upon startup.
#
# USAGE IN LOCAL SHELL / TMUX:
#   Copy this file to ~/.secrets:
#     cp .secrets.example ~/.secrets
#     chmod 600 ~/.secrets
#   Edit ~/.secrets with your personal credentials.
#   ~/.bashrc and ~/.zshrc will source ~/.secrets automatically.
#   Tmux popup key (prefix + g) also loads ~/.secrets.

# ==============================================================================
# AI & LLM Providers (pi coding agent, Claude Code, Gemini, OpenAI, OpenCode)
# ==============================================================================

# --- Azure OpenAI (Used by pi agent, Copilot, and Azure OpenAI clients) ---
export AZURE_OPENAI_API_KEY=""
export AZURE_OPENAI_ENDPOINT="https://<your-resource-name>.openai.azure.com"
export AZURE_OPENAI_BASE_URL="https://<your-resource-name>.openai.azure.com"
export AZURE_OPENAI_RESOURCE_NAME="<your-resource-name>"
export AZURE_RESOURCE_NAME="<your-resource-name>"

# --- OpenAI Direct / DeepSeek ---
export OPENAI_API_KEY=""
export OPENAI_API_BASE="https://api.openai.com/v1"
export OPENAI_DEEPSEEK_API_KEY=""
export OPENAI_DEEPSEEK_API_ENDPOINT="https://api.deepseek.com/v1"

# --- Anthropic & AWS Bedrock (Used by Claude Code) ---
export ANTHROPIC_API_KEY=""
export CLAUDE_CODE_USE_BEDROCK=1
export AWS_REGION="us-east-1"
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""
export AWS_BEARER_TOKEN_BEDROCK=""

# --- Google Gemini / Vertex AI (Used by Gemini CLI in tmux popup) ---
export GEMINI_API_KEY=""
export AVANTE_GEMINI_API_KEY=""
export GOOGLE_CLOUD_PROJECT=""
export GOOGLE_APPLICATION_CREDENTIALS=""
export VERTEX_LOCATION="us-central1"

# --- OpenCode AI ---
export OPENCODE_API_KEY=""

# ==============================================================================
# Cloud Providers & Infrastructure
# ==============================================================================

# --- Yandex Cloud ---
export YANDEX_API_KEY=""
export YANDEX_CLIENT_SECRET=""
export YANDEX_FOLDER_ID=""

# ==============================================================================
# Registries, Red Hat & SAP (Codespaces Secrets)
# ==============================================================================

# --- Red Hat Subscription Manager ---
export SUBSCRIPTION_MANAGER_USERNAME=""
export SUBSCRIPTION_MANAGER_PASSWORD=""

# --- Container Registry (registry.redhat.io, etc.) ---
export REGISTRY_USERNAME=""
export REGISTRY_PASSWORD=""

# --- SAP Operations ---
export SAP_OPERATIONS_DOWNLOAD_USERNAME=""
export SAP_OPERATIONS_DOWNLOAD_PASSWORD=""
export SAP_OPERATIONS_MASTER_PASSWORD=""

# ==============================================================================
# Developer Tools, Version Control & CI
# ==============================================================================

# --- GitHub / GitLab / Renovate ---
# GITHUB_TOKEN is automatically provided inside GitHub Codespaces.
# Override here only if you need a custom personal access token with elevated scopes:
# export GITHUB_TOKEN="ghp_xxx"
export GITLAB_TOKEN=""
export RENOVATE_TOKEN=""

# --- Jira CLI ---
export JIRA_API_TOKEN=""
export JIRA_SERVER=""
export JIRA_AUTH_TYPE="bearer"

# --- Tailscale ---
export TS_AUTHKEY=""

# --- Launchpad / ARA / Automation ---
export LP_EMAIL=""
export LP_PASSWORD=""
export ARA_API_CLIENT="http"
export ARA_API_SERVER="http://127.0.0.1:8000"
