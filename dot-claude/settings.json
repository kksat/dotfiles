{
  "permissions": {
    "allow": [
      "Read(//**)",
      "Bash(xargs:*)",
      "Bash(uv run:*)",
      "Bash(hugo version:*)",
      "Bash(hugo:*)",
      "Bash(just docusaurus-docs:*)",
      "Bash(npm run:*)",
      "WebFetch(domain:starlight.astro.build)",
      "Bash(just starlight-docs:*)",
      "Bash(npx vercel@latest:*)",
      "Bash(git:*)",
      "Bash(uv:*)",
      "Bash(just lint:*)",
      "Bash(git stash:*)",
      "Bash(pip show:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "open-code-review@open-code-review": true
  },
  "extraKnownMarketplaces": {
    "open-code-review": {
      "source": {
        "source": "github",
        "repo": "alibaba/open-code-review"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim",
  "allowedTools": [
    "Read",
    "Glob",
    "Grep"
  ],
  "model": "us.anthropic.claude-opus-4-7"
}
