# --- Homebrew ---------------------------------------------------------------
# .zprofile already runs this for login shells; guard for non-login shells.
if [ -z "$HOMEBREW_PREFIX" ]; then
  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  fi
fi

# --- Tools ------------------------------------------------------------------
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# .zprofile already sources this for login shells; guard for non-login shells.
if [ -z "$ARA_API_CLIENT" ] && [ -f "$HOME/.secrets" ]; then
  . "$HOME/.secrets"
fi

if [ -f "$HOME/.cargo/env" ]; then
  . "$HOME/.cargo/env"
fi

if [ -f "$HOME/.alias" ]; then
  . "$HOME/.alias"
fi
. "$HOME/.config/alias"

# --- Ghostty terminfo --------------------------------------------------------
# Ghostty forwards TERM=xterm-ghostty over SSH, but hosts without Ghostty
# installed lack the entry ("'xterm-ghostty': unknown terminal type").
# Compile the bundled source on demand; tic is idempotent.
if ! infocmp xterm-ghostty &>/dev/null && [[ -f "$HOME/.terminfo/xterm-ghostty" ]]; then
  TERMINFO="$HOME/.terminfo" tic -x "$HOME/.terminfo/xterm-ghostty" &>/dev/null
fi

# --- Editor -----------------------------------------------------------------
if command -v nvim 1>/dev/null; then
  export EDITOR=nvim
else
  export EDITOR=vim
fi

# --- zsh-vi-mode ------------------------------------------------------------
if [[ -f "$HOMEBREW_PREFIX/opt/zsh-vi-mode/share/zsh-vi-mode/zsh-vi-mode.plugin.zsh" ]]; then
  . "$HOMEBREW_PREFIX/opt/zsh-vi-mode/share/zsh-vi-mode/zsh-vi-mode.plugin.zsh"
  zvm_after_init_commands+=('source <(fzf --zsh)')
fi

if [[ -s $HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh ]]; then
  . "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh"
fi

# --- History ----------------------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000000
SAVEHIST=10000000

# --- Completion -------------------------------------------------------------
# Run compinit once. -C skips the security audit and the "new completions"
# scan; regenerate the dump (rm ~/.zcompdump) after installing new tools.
autoload -Uz compinit
compinit -C

# Load Yandex Cloud's 3MB completion only on the first completion request.
# Cache the bash-to-zsh conversion, but do not parse it in every new shell.
_dotfiles_yc_completion() {
  local _zsh_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
  local _yc_src="$HOME/yandex-cloud/completion.zsh.inc"
  local _yc_cache="$_zsh_cache/yc_completion.zsh" _yc_tmp
  if [[ ! -f "$_yc_cache" || "$_yc_src" -nt "$_yc_cache" ]]; then
    mkdir -p "$_zsh_cache" || return
    _yc_tmp=$(mktemp "$_yc_cache.XXXXXX") || return
    if ! {
      cat <<'HELPERS'
__yc_type() { if [ "$1" == "-t" ]; then shift; fi; type "$@"; }
__yc_get_comp_words_by_ref() {
  cur="${COMP_WORDS[COMP_CWORD]}"; prev="${COMP_WORDS[${COMP_CWORD}-1]}"
  words=("${COMP_WORDS[@]}"); cword=("${COMP_CWORD[@]}")
}
autoload -U +X bashcompinit && bashcompinit
HELPERS
      zsh -dfc 'source "$1"; __yc_convert_bash_to_zsh' _ "$_yc_src"
    } > "$_yc_tmp" || ! mv -f -- "$_yc_tmp" "$_yc_cache"; then
      rm -f -- "$_yc_tmp"
      return 1
    fi
  fi
  # The converted file needs sh emulation for its top-level return guard.
  __yc_bash_source() { emulate -L sh; setopt kshglob noshglob braceexpand; source "$@"; }
  __yc_bash_source "$_yc_cache" || return
  # bashcompinit registers a command plus flags, not just a function name.
  [[ $_comps[yc] != _dotfiles_yc_completion ]] || return 1
  ${=_comps[yc]} "$@"
}
if [[ -f "$HOME/yandex-cloud/completion.zsh.inc" ]]; then
  compdef _dotfiles_yc_completion yc
fi

# kubectl completion is slow to generate; load it on first use.
kubectl() {
  unfunction kubectl 2>/dev/null
  source <(command kubectl completion zsh)
  command kubectl "$@"
}

# --- Environment ------------------------------------------------------------
export XDG_CONFIG_HOME="$HOME/.config"
export GOPATH="$HOME/go"
export CLAUDE_CODE_USE_BEDROCK=1

# --- PATH -------------------------------------------------------------------
# Prepend only if not already present, so .zprofile/.zshrc don't duplicate.
path_prepend() {
  [[ -d "$1" ]] || return
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$1:$PATH" ;;
  esac
}
path_prepend "$HOME/.local/bin"
path_prepend "$GOPATH/bin"
path_prepend "$HOME/.antigravity/antigravity/bin"
path_prepend "$HOME/.kimi-code/bin"
path_prepend "/opt/homebrew/opt/openjdk@21/bin"
export ANDROID_SDK_ROOT="$HOME/Library/Android/sdk"
path_prepend "$ANDROID_SDK_ROOT/platform-tools"

# Keep YDB on PATH immediately; defer its completion until the first Tab.
_dotfiles_ydb_completion() {
  source "${XDG_DATA_HOME:-$HOME/.local/share}/ydb/completion.zsh.inc" || return
  _ydb "$@"
}
if [ -f "$HOME/ydb/path.bash.inc" ]; then
  source "$HOME/ydb/path.bash.inc"
  if [[ -f "${XDG_DATA_HOME:-$HOME/.local/share}/ydb/completion.zsh.inc" ]]; then
    compdef _dotfiles_ydb_completion ydb
  fi
fi

# --- entire CLI completion --------------------------------------------------
# Generate on the first Tab, then reuse across shells. Include binary identity
# in the cache key: an upgrade can preserve an older modification timestamp.
_dotfiles_entire_completion() {
  local _cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/entire_completion.zsh"
  local _binary=${commands[entire]:A} _key _saved _generated _tmp
  local -A _stat
  zmodload -F zsh/stat b:zstat || return
  zstat -H _stat "$_binary" || return
  _key="# $_binary:${_stat[device]}:${_stat[inode]}:${_stat[mtime]}:${_stat[ctime]}:${_stat[size]}"
  if [[ -r "$_cache" ]]; then
    IFS= read -r _saved < "$_cache"
  fi
  if [[ $_saved != "$_key" ]]; then
    _generated=$(command entire completion zsh) || return
    [[ -n $_generated ]] || return 1
    mkdir -p "${_cache:h}" || return
    _tmp=$(mktemp "$_cache.XXXXXX") || return
    if ! print -r -- "$_key"$'\n'"$_generated" > "$_tmp" || ! mv -f -- "$_tmp" "$_cache"; then
      rm -f -- "$_tmp"
      return 1
    fi
  fi
  source "$_cache" || return
  _entire "$@"
}
if command -v entire >/dev/null 2>&1; then
  compdef _dotfiles_entire_completion entire
fi
